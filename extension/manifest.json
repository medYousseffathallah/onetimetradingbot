{
  "manifest_version": 3,
  "name": "BVMT Intelligence Companion",
  "version": "1.0.0",
  "description": "Local-first read-only account synchronization companion for Tunis Bourse Challenge.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sync Tunis Bourse Challenge Account"
  }
}
