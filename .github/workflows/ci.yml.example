name: offline-quality
on:
  push:
  pull_request:
permissions:
  contents: read
jobs:
  test:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: ["3.12", "3.13"]
    steps:
      # Replace moving action tags with reviewed immutable commit SHAs before enabling CI.
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
      - run: python -m pip install uv
      - run: uv sync --locked --group dev --python ${{ matrix.python-version }}
      - run: uv run --python ${{ matrix.python-version }} python scripts/check.py
