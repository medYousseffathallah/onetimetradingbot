# No credentials are required for the offline starter or local dashboard.
# Copy to .env only when an explicitly approved integration needs a setting.
BVMT_MODE=research_only
BVMT_TIMEZONE=Africa/Tunis
BVMT_DATA_DIR=data

# Alibaba Cloud Model Studio (DashScope) — Keep offline by default (0).
# Never commit real API keys to Git.
BVMT_ALLOW_LIVE_LLM=0
DASHSCOPE_API_KEY=
