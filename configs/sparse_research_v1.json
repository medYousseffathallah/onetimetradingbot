{
  "schema_version": 1,
  "model_version": "sparse_research_v1",
  "auto_order_submission": false,
  "description": "Point-in-time multi-layer research configuration for sparse/intermittent BVMT equities. Strictly research-only; never executes autonomous orders.",
  "research_parameters": {
    "micro_lookback_sessions": 5,
    "short_lookback_sessions": 20,
    "long_lookback_sessions": 60,
    "awakening_baseline_sessions": 20,
    "min_awakening_baseline_bars": 5,
    "full_max_quote_age_sessions": 2,
    "partial_max_quote_age_sessions": 15,
    "full_min_trade_freq_20s": 0.75,
    "full_max_missing_in_60s": 0,
    "min_partial_traded_bars": 2,
    "liquidity_feasible_median_turnover_tnd": "5000.000",
    "liquidity_marginal_median_turnover_tnd": "1000.000",
    "awakening_turnover_ratio_threshold": 3.0,
    "awakening_min_turnover_tnd": "10000.000",
    "awakening_min_day_return_pct": 0.0,
    "partial_horizon_score_multiplier": 0.65,
    "awakening_score_bonus": 6.0,
    "event_catalyst_score_bonus": 2.5,
    "sparse_zero_vol_penalty": 3.0,
    "sparse_zero_vol_penalty_threshold": 0.4,
    "candidate_min_quant_score": 5.0,
    "candidate_top_k": 8,
    "candidate_allow_awakening_bypass": true,
    "candidate_allow_event_catalyst": true
  },
  "execution_and_risk": {
    "buy_fee_rate": "0.0050",
    "sell_fee_rate": "0.0050",
    "slippage_bps": "20",
    "liquidity_participation_cap": "0.1000",
    "max_single_stock_weight": "0.1000",
    "target_position_weight": "0.0850",
    "minimum_order_notional_tnd": "100.000",
    "daily_collar_static_pct": "3.00"
  },
  "hb_limit_reserved_experiment": {
    "enabled_by_default": false,
    "recovery_rule": "clamp_high_low_to_include_threshold_close_non_destructive",
