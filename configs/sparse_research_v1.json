  "promotion_gates": {
    "min_prospective_settled_signals": 20,
    "min_prospective_sessions": 20,
    "min_non_icf_settled_signals": 15,
    "max_false_positive_rate": 0.45,
    "max_false_positive_uplift_vs_baseline": 0.05,
