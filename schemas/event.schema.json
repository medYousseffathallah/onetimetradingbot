{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-linked event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "source_id",
    "language",
    "published_at",
    "observed_at",
    "policy_stage",
    "effective_date",
    "instrument_ids",
    "evidence",
    "impact_hypothesis",
    "uncertainties"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "enum": [
        "fr",
        "ar",
        "en",
        "other"
      ]
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_stage": {
      "enum": [
        "rumor",
        "proposal",
        "enacted",
        "effective",
        "withdrawn",
        "not_applicable",
        "unknown"
      ]
    },
    "effective_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "instrument_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "locator",
          "original_text"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "original_text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "impact_hypothesis": {
      "type": [
        "string",
        "null"
      ]
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
